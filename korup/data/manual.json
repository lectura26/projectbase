  "safetyNotes": [
    {
      "page": 3,
      "text": "Læs hele manualen før samling, og gem den."
    },
    {
      "page": 4,
      "text": "Saml møblet på et blødt underlag, fx et tæppe, så det ikke får ridser."
    },
    {
      "page": 5,
      "text": "Kommoden skal fastgøres til væggen med det medfølgende vægbeslag. Skruer og rawplugs til væggen medfølger ikke – de afhænger af væggen."
    },
    {
      "page": 7,
      "text": "Efterspænd alle skruer 2 uger efter samling og derefter hver 3. måned."
    },
    {
      "page": 9,
      "text": "Brug ikke boremaskine/skruemaskine til at skrue møblet sammen."
    },
    {
      "page": 10,
      "text": "Saml helst to personer."
    }
  ],
  "steps": [
    {
      "index": 0,
      "manual": "Før du starter",
      "title": "Dele og værktøj",
      "short": "Tjek at alle dele og beslag er der. Saml på et blødt underlag, gerne to personer.",
      "pages": [
        3,
        4,
        5,
        7,
        9,
        10,
        11
      ]
    },
    {
      "index": 1,
      "manual": "1",
      "title": "Excenterbolte i siderne",
      "short": "Skru 3 bolte A i hver side med stjerneskruetrækker. Drej med uret, til kraven rører pladen.",
      "pages": [
        12
      ]
    },
    {
      "index": 2,
      "manual": "2",
      "title": "Skinner på siderne",
      "short": "Skru skinne CL på venstre side 2 og CR på højre side 3 med 2 skruer G pr. skinne.",
      "pages": [
        12
      ]
    },
    {
      "index": 3,
      "manual": "3",
      "title": "Glidere i bunden",
      "short": "Mål 20 mm ind fra for- og bagkant, og bank en glider D i hver side.",
      "pages": [
        13
      ]
    },
    {
      "index": 4,
      "manual": "4",
      "title": "Pløkke i toppen af siderne",
      "short": "Bank 2 træpløkke C i toppen af hver side.",
      "pages": [
        13
      ]
    },
    {
      "index": 5,
      "manual": "5",
      "title": "Pløkke og klodser på listerne",
      "short": "Bank pløkke C i enderne af listerne 4, 5 og 12. Skru klods N under 5 og 12 med 2 skruer M.",
      "pages": [
        14
      ]
    },
    {
      "index": 6,
      "manual": "6",
      "title": "Lister på højre side",
      "short": "Sæt 5, 12 og 4 ned på højre side 3. Sæt excenterlås B i, og drej med uret med ligekærvet skruetrækker.",
      "pages": [
        14
      ]
    },
    {
      "index": 7,
      "manual": "7",
      "title": "Venstre side på",
      "short": "Læg venstre side 2 ned på listerne, og lås med 3 excenterlåse B.",
      "pages": [
        15
      ]
    },
    {
      "index": 8,
      "manual": "8",
      "title": "Bagpladen i",
      "short": "Rejs korpus op, og skub bagpladen 6 ned i rillerne.",
      "pages": [
        15
      ],
      "note": "At rejse korpus op er ikke tegnet i manualen, men er nødvendigt mellem trin 7 og 8."
    },
    {
      "index": 9,
      "manual": "9",
      "title": "Bolte og vægbeslag i toppen",
      "short": "Skru 4 bolte A i toppen 1. Skru vægbeslag E på med 2 skruer F, men kun 80 %.",
      "pages": [
        16
      ]
    },
    {
      "index": 10,
      "manual": "10",
      "title": "Toppen på",
      "short": "Læg toppen på korpus, og lås med 4 excenterlåse B.",
      "pages": [
        16
      ]
    },
    {
      "index": 11,
      "manual": "11",
      "title": "Ret op og fastgør bagpladen",
      "short": "Mål diagonalerne – de skal være lige lange. Skru 8 holdere H på med skruer M.",
      "pages": [
        17
      ]
    },
    {
      "index": 12,
      "manual": "12",
      "title": "Fastgør til væggen",
      "short": "Stil kommoden mod væggen. Afmærk, bor, sæt rawplug i, og skru beslaget fast. Spænd skruerne F 100 %.",
      "pages": [
        18,
        5
      ],
      "note": "Skrue og rawplug til væggen medfølger ikke. Vælg dem efter din væg."
    },
    {
      "index": 13,
      "manual": "13",
      "title": "Bolte i skuffefronterne",
      "short": "Skru 4 bolte A i hver skuffefront 7.",
      "pages": [
        19
      ]
    },
    {
      "index": 14,
      "manual": "14",
      "title": "Pløkke i skuffesiderne",
      "short": "Bank en træpløk C i forenden af hver skuffeside 8 og 9.",
      "pages": [
        19
      ]
    },
    {
      "index": 15,
      "manual": "15",
      "title": "Skuffesider på fronten",
      "short": "Sæt siderne 8 og 9 på fronten, og lås med 4 excenterlåse B pr. skuffe.",
      "pages": [
        20
      ]
    },
    {
      "index": 16,
      "manual": "16",
      "title": "Skuffebunden i",
      "short": "Skub bunden 11 ned i rillerne.",
      "pages": [
        20
      ]
    },
    {
      "index": 17,
      "manual": "17",
      "title": "Bagstykket på",
      "short": "Sæt bagstykket 10 i, og skru det fast med 4 skruer J pr. skuffe.",
      "pages": [
        21
      ]
    },
    {
      "index": 18,
      "manual": "18",
      "title": "Skinner på skufferne",
      "short": "Vend skuffen, og skru DL og DR på med 2 skruer M pr. skinne.",
      "pages": [
        21
      ],
      "note": "At vende skuffen er en tolkning af tegningen, hvor skruerne skrues ind oppefra."
    },
    {
      "index": 19,
      "manual": "19",
      "title": "Greb på",
      "short": "Skru grebet K fast indefra med 2 skruer L.",
      "pages": [
        22
      ]
    },
    {
      "index": 20,
      "manual": "20",
      "title": "Skufferne i",
      "short": "Sæt hjulene på skuffens skinner ind bag hjulene i korpus, og skub skuffen helt ind.",
      "pages": [
        22
      ]
    },
    {
      "index": 21,
      "manual": "21",
      "title": "Færdig",
      "short": "Højst 10 kg på toppen og 5 kg i hver skuffe. Efterspænd skruerne efter 2 uger.",
      "pages": [
        23,
        7
      ]
    }
  ],
